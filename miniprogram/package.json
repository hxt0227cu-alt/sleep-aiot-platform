{
  "name": "sleep-monitor-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "智能睡眠监测台灯微信小程序",
  "scripts": {
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp": "taro build --type weapp",
    "dev:swan": "npm run build:swan -- --watch",
    "build:swan": "taro build --type swan",
    "dev:alipay": "npm run build:alipay -- --watch",
    "build:alipay": "taro build --type alipay",
    "dev:tt": "npm run build:tt -- --watch",
    "build:tt": "taro build --type tt",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:h5": "taro build --type h5",
    "dev:rn": "npm run build:rn -- --watch",
    "build:rn": "taro build --type rn",
    "dev:qq": "npm run build:qq -- --watch",
    "build:qq": "taro build --type qq",
    "dev:jd": "npm run build:jd -- --watch",
    "build:jd": "taro build --type jd",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "build:quickapp": "taro build --type quickapp",
    "lint": "eslint --ext .ts,.tsx src",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.7.7",
    "@tarojs/components": "4.2.1",
    "@tarojs/components-react": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-jd": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "echarts-for-weixin": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.1",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-vue": "^8.0.0",
    "typescript": "^5.9.3",
    "webpack": "5.91.0"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@tarojs/components": {
      "swiper": "12.1.2"
    },
    "@tarojs/components-react": {
      "swiper": "12.1.2"
    },
    "@tarojs/plugin-platform-h5": {
      "lodash-es": "4.18.1"
    },
    "@tarojs/runtime": {
      "lodash-es": "4.18.1"
    },
    "@tarojs/taro-h5": {
      "lodash-es": "4.18.1"
    },
    "lodash": "4.18.1",
    "picomatch": "2.3.2",
    "postcss@^8": "8.5.18",
    "ws": "8.21.1"
  }
