{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "knowledge:ingest": "ts-node --project tsconfig.json scripts/knowledge-ingest.ts",
    "rag:eval": "ts-node --project tsconfig.json scripts/rag-eval.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:ci": "node scripts/lint-ratchet.cjs",
    "lint:baseline": "node scripts/lint-ratchet.cjs --update",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:adopt": "node scripts/adopt-migration-baseline.cjs",
    "migration:deploy": "prisma migrate deploy",
    "migration:status": "prisma migrate status",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:rag:pgvector": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand knowledge.pgvector.integration",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "cross-env NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit",
    "prebuild": "prisma generate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/platform-ws": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mqtt": "^5.15.0",
    "openai": "^6.39.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.19.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "cross-env": "^7.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0"
      }
    },
    "overrides": {
      "fast-uri@^3.0.0": "3.1.6",
      "fast-uri@^4.0.0": "4.1.3",
      "find-my-way": "9.7.0",
      "ip-address@^10.0.0": "10.4.0",
      "js-yaml@5.2.1": "5.2.2",
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.22.0"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=9"
  }
}
