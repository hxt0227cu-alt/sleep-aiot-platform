{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleep.example/schemas/device-telemetry.v1.json",
  "title": "DeviceTelemetryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "schemaVersion", "tenantId", "deviceId", "occurredAt"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "schemaVersion": {"const": 1},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
    "deviceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurredAt": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 0},
    "heartRate": {"type": "integer", "minimum": 20, "maximum": 240},
    "breathingRate": {"type": "integer", "minimum": 2, "maximum": 80},
    "bodyMovement": {"type": "number", "minimum": 0},
    "sleepState": {"enum": ["awake", "light", "deep", "rem", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

