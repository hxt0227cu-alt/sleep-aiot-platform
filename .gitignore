# ---- Dependencies / Build artifacts ----
node_modules/
**/node_modules/
dist/
build/
coverage/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.terraform/
*.class
*.jar
# Maven/Gradle build output
target/
**/target/
.mvn/
.gradle/
# Java build reports
surefire-reports/
maven-status/
maven-archiver/

# ---- Accidental nested .git backups (never commit) ----
.git.nested-*/
**/.git.nested-*/

# ---- Local environment / secrets ----
.env
.env.local
.env.production
.env.development
.env.test
.env.*.local
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
pki/

# ---- Logs ----
*.log
logs/
**/logs/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Firmware generated ----
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old

# ---- Miniprogram generated ----
miniprogram/dist/
miniprogram/.swc/
miniprogram/project.private.config.json

# ---- dbt build artifacts (generated) ----
platform/data/dbt/target/
platform/data/dbt/logs/

# ---- K8s rendered deployment bundles (generated by New-DeploymentBundle.ps1) ----
platform/k8s/rendered/

# ---- Local archives (not part of product) ----
ui*.zip
ui*.make
*.tar.gz
*.zip
*.jpg
*.png
# Product image assets that must be tracked (miniprogram UI/icon assets)
!miniprogram/src/assets/**/*.jpg
!miniprogram/src/assets/**/*.png

# ---- Misc ----
.tmp/
tmp/
*.tsbuildinfo
